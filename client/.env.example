# Optional. The hidden admin page lives at /<this value>. Change it to something only you know.
VITE_ADMIN_PATH=admin
# Local dev: http://localhost:5000
# Production: https://dreamyard.onrender.com
VITE_API_URL=http://localhost:5000

# Google OAuth web client ID (same ID as GOOGLE_CLIENT_ID in server/.env)
VITE_GOOGLE_CLIENT_ID=your-google-oauth-client-id.apps.googleusercontent.com
