# Copy to .env and fill in
PORT=5000
NODE_ENV=development

# MongoDB Atlas connection string (Atlas > Connect > Drivers). Keep the database name at the end.
MONGO_URI=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/dream-yard?retryWrites=true&w=majority

# Allowed frontend origins, comma-separated
CLIENT_ORIGIN=http://localhost:5173

# Google OAuth web client ID (same ID as VITE_GOOGLE_CLIENT_ID in client/.env)
GOOGLE_CLIENT_ID=your-google-oauth-client-id.apps.googleusercontent.com

# Cloudinary image hosting
CLOUDINARY_CLOUD_NAME=your_cloud_name_here
CLOUDINARY_API_KEY=your_api_key_here
CLOUDINARY_API_SECRET=your_api_secret_here

# Admin sign-in (used by the hidden admin page)
ADMIN_EMAIL=admin@DreamYard.test
ADMIN_PASSWORD=change-this-password
JWT_SECRET=replace-with-a-long-random-string

# Set to true to require Razorpay at checkout; false keeps Pay on Delivery.
RAZORPAY_ENABLED=false
# Required only when RAZORPAY_ENABLED=true. Use Razorpay test keys first.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=


